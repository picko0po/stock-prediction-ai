        "import yfinance as yf\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import os\n",
        "\n",
        "# ==========================================\n",
        "# 1. STOCKS WE WILL USE\n",
        "# ==========================================\n",
        "\n",
        "TICKERS = [\"AAPL\", \"MSFT\", \"AMZN\", \"GOOGL\"]\n",
        "\n",
        "print(\"Downloading:\")\n",
        "print(TICKERS)\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 2. DOWNLOAD HISTORICAL DATA\n",
        "# ==========================================\n",
        "\n",
        "data = yf.download(\n",
        "    TICKERS,\n",
        "    period=\"10y\",\n",
        "    interval=\"1d\",\n",
        "    auto_adjust=True,\n",
        "    group_by=\"ticker\",\n",
        "    progress=False\n",
        ")\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 3. PREPARE EACH STOCK\n",
        "# ==========================================\n",
        "\n",
        "all_data = []\n",
        "\n",
        "for ticker in TICKERS:\n",
        "\n",
        "    df = data[ticker].copy()\n",
        "\n",
        "    df = df[[\"Open\", \"High\", \"Low\", \"Close\", \"Volume\"]]\n",
        "\n",
        "    df[\"Ticker\"] = ticker\n",
        "\n",
        "    # Daily return\n",
        "    df[\"Return\"] = df[\"Close\"].pct_change()\n",
        "\n",
        "    # Technical features\n",
        "    df[\"MA_5\"] = df[\"Close\"].rolling(5).mean()\n",
        "    df[\"MA_20\"] = df[\"Close\"].rolling(20).mean()\n",
        "\n",
        "    df[\"Volatility_20\"] = df[\"Return\"].rolling(20).std()\n",
        "\n",
        "    # Target: next-day return\n",
        "    df[\"Target\"] = df[\"Return\"].shift(-1)\n",
        "\n",
        "    all_data.append(df)\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 4. COMBINE THE FOUR STOCKS\n",
        "# ==========================================\n",
        "\n",
        "dataset = pd.concat(all_data)\n",
        "\n",
        "dataset = dataset.dropna()\n",
        "\n",
        "dataset = dataset.reset_index()\n",
        "\n",
        "print(\"\\nDataset created successfully!\")\n",
        "print(\"Rows:\", len(dataset))\n",
        "print(\"Columns:\", len(dataset.columns))\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 5. DISPLAY INFORMATION\n",
        "# ==========================================\n",
        "\n",
        "print(\"\\nStocks:\")\n",
        "print(dataset[\"Ticker\"].value_counts())\n",
        "\n",
        "print(\"\\nColumns:\")\n",
        "print(dataset.columns.tolist())\n",
        "\n",
        "print(\"\\nFirst 5 rows:\")\n",
        "display(dataset.head())\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 6. SAVE DATASET\n",
        "# ==========================================\n",
        "\n",
        "save_path = \"/content/stock_prediction_ai/stock_dataset.csv\"\n",
        "\n",
        "dataset.to_csv(\n",
        "    save_path,\n",
        "    index=False\n",
        ")\n",
        "\n",
        "print(\"\\nSaved to:\")\n",
        "print(save_path)"
      ],
